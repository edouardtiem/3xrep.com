# Noms exacts lus par le code. Voir docs/checkout.md. Ne pas inventer de clés.
# Vercel → Settings → Environment Variables. Sensitive pour les secrets.

# Stripe success/cancel en local. Le connector affiché (home, docs, install) est toujours https://3xrep.com/api/mcp.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# rk_test_… / sk_test_… en recette. rk_live_… / sk_live_… en prod — compte Stripe 3xrep seulement.
STRIPE_SECRET_KEY=
# whsec_… de l’endpoint https://<NEXT_PUBLIC_SITE_URL>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# price_… abo $129,00 USD / mois (créer le Price à la main, Dashboard Stripe 3xrep)
STRIPE_PRICE_ID=
# Projet Supabase 3xrep — pas jesaisfaire. URL = https://<ref>.supabase.co (sans /rest/v1)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alias dashboard, lus par le journal si les deux ci-dessus sont vides :
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# Local seulement. Les tools payants sans Stripe.
DEV_ORG_KEY=3xr_dev_local

# Boucle seo-geo — Search Console + Analytics (lecture). Pas dans git. Voir docs/visibility/seo-geo.md
# JSON du compte de service (un seul, les deux APIs).
# Alias accepté : GA4_SERVICE_ACCOUNT_JSON (même JSON).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Propriété Search Console. Défaut https://3xrep.com/ si vide.
GSC_SITE_URL=https://3xrep.com/
# Id numérique de la propriété Analytics (Admin → Property settings). Pas le tag G-YWQX4MDHZP.
GA4_PROPERTY_ID=
